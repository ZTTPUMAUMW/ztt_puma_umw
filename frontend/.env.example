# Public CMS configuration. Use production only in the final production environment.
NEXT_PUBLIC_SANITY_PROJECT_ID=s2jrzn3b
NEXT_PUBLIC_SANITY_DATASET=development

# Gmail SMTP. Leave password blank until deliberately testing email delivery.
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=test-recipient@example.com

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Set true only for the hosted review site: disables form submission UI.
NEXT_PUBLIC_REVIEW_MODE=false
